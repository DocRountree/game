; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game"
config/description="Open-world ocean game."
run/main_scene="res://src/world/open_ocean/open_ocean.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
Game="*res://src/autoload/game.gd"
Settings="*res://src/autoload/settings.gd"
Perf="*res://src/autoload/perf.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
tread={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
respawn={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
camera_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194319)]
}
camera_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194321)]
}
camera_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194320)]
}
camera_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194322)]
}
toggle_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
time_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":91)]
}
time_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":93)]
}
toggle_view={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}
quit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="characters"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
